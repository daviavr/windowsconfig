#!/usr/bin/env bash

set -e

main() {
  if [ "$#" -eq 0 ]; then
    echo "no arguments provided" >&2
    exit 1
  fi

  case "$1" in
    rebase)
      rebase
      ;;
    log)
      log "$@"
      ;;
    uncommit)
      uncommit
      ;;
    recommit)
      recommit
      ;;
    new)
      new "$@"
      ;;
    *)
      echo "Unknown command"
      ;;
  esac
}

rebase() {
  git fetch upstream master --tags
  git rebase upstream/master
}

log() {
  if [ "${2:-}" = "all" ]; then
    git log --graph --decorate \
      --pretty=format:'%C(auto)%h %d %s %C(green)(%cr) %C(bold blue)<%an>%C(reset)' \
      --all
  else
    git log --graph --decorate \
      --pretty=format:'%C(auto)%h %d %s %C(green)(%cr) %C(bold blue)<%an>%C(reset)'
  fi
}

uncommit() {
  git reset --soft HEAD~1
}

recommit() {
  local message
  message="$(git log -1 --format=%s | tr -d '\n' | sed 's/[[:space:]]*$//')"

  git reset --soft HEAD~1
  git commit -m "$message"
}

new() {
  if [ -n "${2:-}" ]; then
    git checkout -b "$2"
  else
    echo "Not enough arguments"
  fi
}

main "$@"
